; Engine configuration file for PIPWRECK.
; Godot 4.6 stable. Portrait mobile, typed GDScript 2.0.

config_version=5

[application]

config/name="PIPWRECK"
config/description="Tärningsroguelike för mobil. Sex tärningar, fem slots, kedja vänster→höger."
config/version="0.0.1"
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=360
window/size/window_height_override=640
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="PIPWRECK"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
